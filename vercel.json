{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd apps/techatlas/web && npm install",
  "buildCommand": "cd apps/techatlas/web && npm run build",
  "outputDirectory": "apps/techatlas/web/dist",
  "functions": {
    "api/*.py": {
      "includeFiles": "apps/techatlas/pipeline/**"
    }
  },
  "crons": [
    { "path": "/api/refresh", "schedule": "0 6 * * *" }
  ]
}
